# BudgetPlaner – Einstellungen für den Betrieb auf dem Raspberry Pi
# install.sh erzeugt daraus /etc/budgetplaner/budgetplaner.env (nur für root und den Dienst lesbar)
# und setzt die Schlüssel automatisch. Nach Änderungen: sudo systemctl restart budgetplaner
#
# Format: SCHLÜSSEL=Wert, eine Zeile je Einstellung, keine Leerzeichen um das „=“.
# Enthält ein Wert Leerzeichen, # oder Anführungszeichen, ihn in "…" setzen und darin " und \ als \" bzw. \\ schreiben.

ASPNETCORE_ENVIRONMENT=Production
DOTNET_gcServer=0
DOTNET_EnableDiagnostics=0
Logging__Console__FormatterName=systemd

# Öffentliche Adresse (Tailscale Funnel), ohne „/“ am Ende. Bestimmt Links in E-Mails und die Passkey-Domain.
App__PublicBaseUrl=https://budget.tailXXXX.ts.net
# Administratoren (Verwaltung unter /verwaltung), mehrere durch Komma getrennt.
App__AdminEmails=du@example.com
# Registrierung, bis in der Verwaltung etwas anderes gewählt wird: approval = „Auf Anfrage“ (Neue stellen eine Anfrage,
# du schaltest frei – an Unbekannte geht keine Mail), open, allowlist oder closed.
App__DefaultRegistrationMode=approval
App__DataDirectory=/var/lib/budgetplaner
# TLS endet bei Tailscale; HSTS wird gesendet, sobald Tailscale „X-Forwarded-Proto: https“ meldet.
App__RequireHttps=true
App__BackupRetentionDays=14

# Schlüssel – werden bei der Installation erzeugt. NIE ändern, sonst sind gespeicherte Daten nicht mehr lesbar.
# Zusammen mit der Datenbank sichern (backup.sh macht das).
Security__EncryptionKey=
Security__JwtSigningKey=

# E-Mail-Versand (Pflicht – ohne E-Mail kann sich niemand anmelden). Leerer Host = Versand aus.
# Jedes Postfach mit SMTP-Zugang geht (Port 587, StartTls; Benutzer = vollständige Adresse):
#   Gmail     smtp.gmail.com   Passwort = App-Passwort (Google-Konto → Sicherheit, 2-Schritt-Bestätigung nötig)
#   GMX       mail.gmx.net     vorher in GMX: Einstellungen → POP3/IMAP Abruf → Senden über externe Programme erlauben
#   WEB.DE    smtp.web.de      wie GMX
#   IONOS     smtp.ionos.de
#   T-Online  securesmtp.t-online.de   Passwort = E-Mail-Passwort (nicht das Kundencenter-Passwort)
# Absender leer lassen = das Postfach selbst (andere Absender lehnen die Anbieter meist ab).
Smtp__Host=
Smtp__Port=587
Smtp__Security=StartTls
Smtp__User=
Smtp__Password=
Smtp__From=
Smtp__FromName=BudgetPlaner

# Kontaktadresse für Web-Push (mailto:…); die Push-Schlüssel erzeugt die App selbst.
Push__Subject=mailto:du@example.com
