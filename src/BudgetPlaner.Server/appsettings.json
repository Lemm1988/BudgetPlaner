{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": "",
    "AdminEmails": "",
    "DevMailbox": false,
    "RequireHttps": true,
    "DataDirectory": "App_Data",
    "BackgroundJobs": true,
    "MonthStartReminderHour": 8,
    "BackupRetentionDays": 14
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "noreply@example.com",
    "FromName": "BudgetPlaner",
    "Security": "StartTls"
  },
  "Push": {
    "Subject": "mailto:admin@example.com"
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "ApiPerMinute": 1200
  }
}
