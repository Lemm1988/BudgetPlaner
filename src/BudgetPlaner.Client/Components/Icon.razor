@* Inline-SVG-Icons (Strichstärke 2, 24×24) – offlinefähig, ohne externe Abhängigkeit. *@
<svg class="i @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label is null ? "true" : "false")" role="@(Label is null ? null : "img")" focusable="false">
    @if (Label is not null)
    {
        <title>@Label</title>
    }
    @((MarkupString)(Paths.TryGetValue(Name, out var p) ? p : Paths["dot"]))
</svg>

