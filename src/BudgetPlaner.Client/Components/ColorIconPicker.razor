@inject Loc L

@* Auswahl von Farbe und Symbol (Polster, Kategorien): Radiogruppen, per Tastatur mit Pfeiltasten bedienbar. *@
<div class="form-grid">
    <fieldset class="picker">
        <legend class="label">@L["picker.color"]</legend>
        <div class="swatches">
            @for (var i = 0; i < Colors.Length; i++)
            {
                var c = Colors[i];
                <label class="swatch-opt" style="--c:@c">
                    <input type="radio" name="@(_name)-c" checked="@(string.Equals(Color, c, StringComparison.OrdinalIgnoreCase))" @onchange="() => ColorChanged.InvokeAsync(c)" />
                    <span aria-hidden="true"></span>
                    <span class="sr-only">@L["picker.color." + i]</span>
                </label>
            }
        </div>
    </fieldset>
    <fieldset class="picker">
        <legend class="label">@L["picker.icon"]</legend>
        <div class="icon-opts">
            @for (var i = 0; i < Icons.Length; i++)
            {
                var name = Icons[i];
                <label class="icon-opt">
                    <input type="radio" name="@(_name)-i" checked="@(IconName == name)" @onchange="() => IconNameChanged.InvokeAsync(name)" />
                    <span aria-hidden="true"><Icon Name="@name" /></span>
                    <span class="sr-only">@L.T("picker.iconN", i + 1)</span>
                </label>
            }
        </div>
    </fieldset>
</div>

@code {
    public static readonly string[] Colors = ["#2E7D5B", "#3A7CA5", "#B5651D", "#7B5EA7", "#B23A6B", "#00796B", "#8D6E63", "#546E7A"];
    public static readonly string[] DefaultIcons = ["piggy", "shield", "target", "car", "home", "gift", "heart", "briefcase", "sparkles", "basket", "phone", "book"];

    private readonly string _name = "pick-" + Guid.NewGuid().ToString("N")[..6];

    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<string?> ColorChanged { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public EventCallback<string?> IconNameChanged { get; set; }
    [Parameter] public string[] Icons { get; set; } = DefaultIcons;
}
