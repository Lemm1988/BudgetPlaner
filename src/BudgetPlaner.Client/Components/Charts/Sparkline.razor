@* Mini-Verlauf (zurückgenommene Farbe, aktueller Wert als Punkt). *@
<svg class="chart" width="@Width" height="@Height" viewBox="0 0 @Width @Height" role="img" aria-label="@Label">
    @if (Points.Count > 1)
    {
        <path d="@PathData" fill="none" stroke="var(--text-faint)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
        <circle cx="@ChartMath.F(X(Points.Count - 1))" cy="@ChartMath.F(Y(Points[^1]))" r="3.5" fill="var(--chart-1)" stroke="var(--surface)" stroke-width="2" />
    }
</svg>

@code {
    [Parameter] public IReadOnlyList<decimal?> Values { get; set; } = [];
    [Parameter] public int Width { get; set; } = 96;
    [Parameter] public int Height { get; set; } = 28;
    [Parameter] public string? Label { get; set; }

    private List<decimal> Points => Values.Where(v => v is not null).Select(v => v!.Value).ToList();
    private decimal Min => Points.Count == 0 ? 0 : Points.Min();
    private decimal Max => Points.Count == 0 ? 1 : Points.Max();

    private double X(int i) => 4 + (Width - 8) * (Points.Count <= 1 ? 0 : (double)i / (Points.Count - 1));
    private double Y(decimal v) => Max == Min ? Height / 2.0 : 4 + (Height - 8) * (double)((Max - v) / (Max - Min));

    private string PathData => string.Join(" ", Points.Select((v, i) => $"{(i == 0 ? "M" : "L")}{ChartMath.F(X(i))},{ChartMath.F(Y(v))}"));
}
