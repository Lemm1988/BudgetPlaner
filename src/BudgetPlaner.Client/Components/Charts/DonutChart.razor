@inherits ChartBase

@* Ringdiagramm (F-060): Teile eines Ganzen, max. 6 Segmente (Rest = „Weitere“), 2px Lücken, Legende = Tabelle mit Beträgen und Anteilen. *@
<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));align-items:center" @ref="Container">
    <svg class="chart" width="@Size" height="@Size" viewBox="0 0 @Size @Size" role="img" aria-label="@AriaSummary" style="margin:0 auto">
        @{
            var cx = Size / 2.0;
            var cy = Size / 2.0;
            var r = Size / 2.0 - 6;
            var thickness = Math.Max(18, Size * 0.13);
            var total = (double)Shown.Sum(s => s.Value);
            var angle = -Math.PI / 2;
        }
        <circle cx="@F(cx)" cy="@F(cy)" r="@F(r - thickness / 2)" fill="none" stroke="var(--surface-2)" stroke-width="@F(thickness)" />
        @if (total > 0)
        {
            @foreach (var seg in Shown)
            {
                var sweep = (double)seg.Value / total * Math.PI * 2;
                var active = _active == seg.Key || Selected == seg.Key;
                <path d="@Arc(cx, cy, r - thickness / 2, angle, angle + sweep)" fill="none" stroke="@seg.Color" stroke-width="@F(active ? thickness + 6 : thickness)"
                      style="cursor:@(OnSelect.HasDelegate ? "pointer" : "default")" @onmouseenter="() => _active = seg.Key" @onmouseleave="() => _active = null"
                      @onclick="() => Select(seg.Key)" />
                @if (Shown.Count > 1)
                {
                    <path d="@Line(cx, cy, r - thickness - 4, r + 4, angle)" stroke="var(--surface)" stroke-width="2" />
                }
                angle += sweep;
            }
        }
        <text x="@F(cx)" y="@F(cy - 4)" text-anchor="middle" style="font-size:12px">@CenterCaption</text>
        <text class="donut-center" x="@F(cx)" y="@F(cy + 16)" text-anchor="middle" style="font-size:16px;fill:var(--text)">@CenterValue</text>
    </svg>
    <table class="legend-table">
        <caption class="sr-only">@Title</caption>
        <thead class="sr-only"><tr><th scope="col">@L["chart.category"]</th><th scope="col">@L["chart.amount"]</th><th scope="col">@L["chart.share"]</th></tr></thead>
        <tbody>
            @foreach (var seg in Shown)
            {
                var pct = Total == 0 ? 0 : seg.Value / Total * 100;
                <tr @onmouseenter="() => _active = seg.Key" @onmouseleave="() => _active = null" style="@(Selected == seg.Key ? "background:var(--primary-soft)" : null)">
                    <td>
                        @if (OnSelect.HasDelegate && seg.Key != OtherKey)
                        {
                            <button type="button" @onclick="() => Select(seg.Key)" aria-pressed="@(Selected == seg.Key ? "true" : "false")">
                                <span class="swatch" style="width:12px;height:12px;border-radius:3px;background:@seg.Color;display:inline-block"></span>@seg.Label
                            </button>
                        }
                        else
                        {
                            <span class="row" style="gap:.45rem;flex-wrap:nowrap"><span style="width:12px;height:12px;border-radius:3px;background:@seg.Color;display:inline-block"></span>@seg.Label</span>
                        }
                    </td>
                    <td class="num right">@Format(seg.Value)</td>
                    <td class="num right muted" style="width:4.5rem">@L.Pct(pct)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr><td><strong>@L["chart.total"]</strong></td><td class="num right"><strong>@Format(Total)</strong></td><td class="num right muted">@L.Pct(Total == 0 ? 0 : 100m)</td></tr>
        </tfoot>
    </table>
</div>

@code {
    private const string OtherKey = "__other";
    private string? _active;

    [Parameter] public IReadOnlyList<DonutSegment> Segments { get; set; } = [];
    [Parameter] public Func<decimal, string> Format { get; set; } = v => v.ToString("0.##");
    [Parameter] public string? CenterCaption { get; set; }
    [Parameter] public string? CenterValueOverride { get; set; }
    [Parameter] public string? Selected { get; set; }
    [Parameter] public EventCallback<string?> OnSelect { get; set; }
    [Parameter] public int MaxSegments { get; set; } = 6;

    private int Size => (int)Math.Clamp(Math.Min(Width, 240), 160, 240);
    private decimal Total => Segments.Where(s => s.Value > 0).Sum(s => s.Value);
    private string CenterValue => CenterValueOverride ?? Format(Total);

    /// <summary>Höchstens <see cref="MaxSegments"/> Segmente; der Rest wird zu „Weitere“ zusammengefasst.</summary>
    private List<DonutSegment> Shown
    {
        get
        {
            var positive = Segments.Where(s => s.Value > 0).ToList();
            if (positive.Count <= MaxSegments) return positive;
            var head = positive.OrderByDescending(s => s.Value).Take(MaxSegments - 1).ToHashSet();
            var list = positive.Where(head.Contains).ToList();
            list.Add(new DonutSegment(OtherKey, L["chart.other"], positive.Where(s => !head.Contains(s)).Sum(s => s.Value), "var(--chart-other)"));
            return list;
        }
    }

    private string AriaSummary => $"{Title}: " + string.Join(", ", Shown.Select(s => $"{s.Label} {Format(s.Value)}"));

    private async Task Select(string key)
    {
        if (!OnSelect.HasDelegate || key == OtherKey) return;
        await OnSelect.InvokeAsync(Selected == key ? null : key);
    }

    private static string Arc(double cx, double cy, double r, double a0, double a1)
    {
        if (a1 - a0 >= Math.PI * 2 - 0.0001) a1 = a0 + Math.PI * 2 - 0.0001;
        var x0 = cx + r * Math.Cos(a0);
        var y0 = cy + r * Math.Sin(a0);
        var x1 = cx + r * Math.Cos(a1);
        var y1 = cy + r * Math.Sin(a1);
        var large = a1 - a0 > Math.PI ? 1 : 0;
        return $"M{F(x0)},{F(y0)} A{F(r)},{F(r)} 0 {large} 1 {F(x1)},{F(y1)}";
    }

    private static string Line(double cx, double cy, double r0, double r1, double a) =>
        $"M{F(cx + r0 * Math.Cos(a))},{F(cy + r0 * Math.Sin(a))} L{F(cx + r1 * Math.Cos(a))},{F(cy + r1 * Math.Sin(a))}";
}
