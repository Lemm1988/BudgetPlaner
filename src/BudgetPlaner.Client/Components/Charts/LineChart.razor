@inherits ChartBase

@* Liniendiagramm: Lücken bei null (F-061), gestrichelte/eigene Farbe für Prognosen (F-070), Fadenkreuz-Tooltip per Maus/Tastatur. *@
<div class="chart-wrap" @ref="Container">
    <svg class="chart" width="@Width" height="@Height" viewBox="0 0 @Width @Height" role="img" aria-label="@Title"
         tabindex="0" @onkeydown="OnKey" @onfocusout="() => _hover = null">
        @{
            var plot = Layout();
        }
        @foreach (var t in plot.Ticks)
        {
            var y = plot.Y(t);
            <line class="@(t == 0 ? "axis" : "grid-line")" x1="@F(plot.Left)" x2="@F(Width - plot.Right)" y1="@F(y)" y2="@F(y)" />
            <g><text class="tick-label" x="@F(plot.Left - 6)" y="@F(y + 4)" text-anchor="end">@YAxis(t)</text></g>
        }
        @for (var i = 0; i < Labels.Count; i++)
        {
            var lastLabel = Labels.Count - 1;
            if (i != lastLabel && (i % plot.LabelEvery != 0 || lastLabel - i < plot.LabelEvery)) continue;
            <g><text x="@F(plot.X(i))" y="@F(Height - 8)" text-anchor="middle">@Labels[i]</text></g>
        }
        @if (TargetLine is { } target)
        {
            var ty = plot.Y((double)target);
            <line x1="@F(plot.Left)" x2="@F(Width - plot.Right)" y1="@F(ty)" y2="@F(ty)" stroke="var(--text-muted)" stroke-width="1.5" stroke-dasharray="4 4" />
            <g><text x="@F(Width - plot.Right - 2)" y="@F(ty - 5)" text-anchor="end" style="font-size:11px">@TargetLabel</text></g>
        }
        @if (MarkIndex is { } mi && mi >= 0 && mi < Labels.Count)
        {
            <line class="crosshair" x1="@F(plot.X(mi))" x2="@F(plot.X(mi))" y1="@F(plot.Top)" y2="@F(Height - plot.Bottom)" stroke-dasharray="2 3" />
            <g><text x="@F(plot.X(mi) + 4)" y="@F(plot.Top + 10)" style="font-size:11px">@(MarkLabel ?? "")</text></g>
        }
        @foreach (var s in Series)
        {
            @if (s.Area)
            {
                @foreach (var area in AreaPaths(s, plot))
                {
                    <path d="@area" fill="@s.Color" opacity="0.1" />
                }
            }
            <path d="@LinePath(s, plot)" fill="none" stroke="@s.Color" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"
                  stroke-dasharray="@(s.Dashed ? "6 5" : null)" />
            @if (LastIndex(s) is { } li)
            {
                <circle class="marker" cx="@F(plot.X(li))" cy="@F(plot.Y((double)s.Values[li]!.Value))" r="4" fill="@s.Color" />
            }
        }
        @if (_hover is { } h)
        {
            <line class="crosshair" x1="@F(plot.X(h))" x2="@F(plot.X(h))" y1="@F(plot.Top)" y2="@F(Height - plot.Bottom)" />
            @foreach (var s in Series)
            {
                @if (h < s.Values.Count && s.Values[h] is { } v)
                {
                    <circle class="marker" cx="@F(plot.X(h))" cy="@F(plot.Y((double)v))" r="5" fill="@s.Color" />
                }
            }
        }
        @for (var i = 0; i < Labels.Count; i++)
        {
            var idx = i;
            var x0 = plot.X(i) - plot.Step / 2;
            <rect class="hit" x="@F(Math.Max(plot.Left, x0))" y="@F(plot.Top)" width="@F(Math.Max(1, plot.Step))" height="@F(Height - plot.Top - plot.Bottom)"
                  @onmouseenter="() => _hover = idx" @onmouseleave="() => _hover = null" @onclick="() => _hover = idx" />
        }
    </svg>
    @if (_hover is { } hv && hv < Labels.Count)
    {
        var plot2 = Layout();
        var left = Math.Clamp(plot2.X(hv) + 10, 0, Math.Max(0, Width - 190));
        <div class="chart-tooltip" style="left:@F(left)px;top:@F(plot2.Top)px" role="status">
            <strong>@(TooltipLabels?[hv] ?? Labels[hv])</strong>
            @foreach (var s in Series)
            {
                <div class="row" style="gap:.4rem;flex-wrap:nowrap">
                    <span class="swatch" style="width:10px;height:10px;border-radius:3px;background:@s.Color;display:inline-block"></span>
                    <span>@s.Label:</span>
                    <strong class="num">@(hv < s.Values.Count && s.Values[hv] is { } v ? Format(v) : "–")</strong>
                </div>
            }
        </div>
    }
    @if (Series.Count > 1 || ShowLegend)
    {
        <div class="chart-legend" aria-hidden="true">
            @foreach (var s in Series)
            {
                <span class="item"><span class="swatch line @(s.Dashed ? "dashed" : "")" style="background:@s.Color;color:@s.Color"></span>@s.Label</span>
            }
        </div>
    }
    <details class="chart-table-toggle">
        <summary class="small">@L["chart.showTable"]</summary>
        <div class="table-wrap mt-1">
            <table class="table">
                <caption class="sr-only">@Title</caption>
                <thead>
                    <tr>
                        <th scope="col">@(XTitle ?? L["chart.period"])</th>
                        @foreach (var s in Series)
                        {
                            <th scope="col" class="num">@s.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Labels.Count; i++)
                    {
                        <tr>
                            <th scope="row">@(TooltipLabels?[i] ?? Labels[i])</th>
                            @foreach (var s in Series)
                            {
                                <td class="num">@(i < s.Values.Count && s.Values[i] is { } v ? Format(v) : "–")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
</div>

@code {
    private int? _hover;

    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];
    [Parameter] public IReadOnlyList<string>? TooltipLabels { get; set; }
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = [];
    [Parameter] public Func<decimal, string> Format { get; set; } = v => v.ToString("0.##");
    [Parameter] public Func<decimal, string>? AxisFormat { get; set; }
    [Parameter] public int? MarkIndex { get; set; }
    [Parameter] public string? MarkLabel { get; set; }
    [Parameter] public string? XTitle { get; set; }
    [Parameter] public bool ShowLegend { get; set; }
    [Parameter] public bool IncludeZero { get; set; } = true;
    [Parameter] public decimal? TargetLine { get; set; }
    [Parameter] public string? TargetLabel { get; set; }

    private string YAxis(double v) => (AxisFormat ?? Format)((decimal)v);

    private sealed record Plot(double Left, double Right, double Top, double Bottom, double Min, double Max, List<double> Ticks, double Step, int LabelEvery, double Height)
    {
        public double X(int i) => Left + Step * i + Step / 2;
        public double Y(double v) => Top + (Max - v) / (Max - Min == 0 ? 1 : Max - Min) * (Height - Top - Bottom);
    }

    private Plot Layout()
    {
        var values = Series.SelectMany(s => s.Values).Where(v => v is not null).Select(v => (double)v!.Value).ToList();
        var min = values.Count == 0 ? 0 : values.Min();
        var max = values.Count == 0 ? 1 : values.Max();
        if (IncludeZero) { min = Math.Min(0, min); max = Math.Max(0, max); }
        if (TargetLine is { } tl) { min = Math.Min(min, (double)tl); max = Math.Max(max, (double)tl); }
        var (nMin, nMax, step) = ChartMath.NiceScale(min, max);
        var ticks = new List<double>();
        for (var t = nMin; t <= nMax + step / 2; t += step) ticks.Add(Math.Round(t, 6));
        var labelWidth = ticks.Select(t => YAxis(t).Length).DefaultIfEmpty(4).Max() * 6.6 + 10;
        var left = Math.Min(labelWidth, Width * 0.35);
        const double right = 12, top = 12, bottom = 28;
        var n = Math.Max(1, Labels.Count);
        var plotW = Math.Max(10, Width - left - right);
        var stepX = plotW / n;
        var labelChars = Labels.Count == 0 ? 4 : Labels.Max(l => l.Length);
        var every = Math.Max(1, (int)Math.Ceiling(labelChars * 7.5 / stepX));
        return new Plot(left, right, top, bottom, nMin, nMax, ticks, stepX, every, Height);
    }

    private string LinePath(ChartSeries s, Plot p)
    {
        var sb = new System.Text.StringBuilder();
        var pen = false;
        for (var i = 0; i < s.Values.Count && i < Labels.Count; i++)
        {
            if (s.Values[i] is not { } v) { pen = false; continue; }
            sb.Append(pen ? " L" : " M").Append(F(p.X(i))).Append(',').Append(F(p.Y((double)v)));
            pen = true;
        }
        return sb.ToString();
    }

    private IEnumerable<string> AreaPaths(ChartSeries s, Plot p)
    {
        var baseY = p.Y(Math.Max(p.Min, 0));
        var segment = new List<(double X, double Y)>();
        for (var i = 0; i <= s.Values.Count; i++)
        {
            if (i < s.Values.Count && i < Labels.Count && s.Values[i] is { } v)
            {
                segment.Add((p.X(i), p.Y((double)v)));
                continue;
            }
            if (segment.Count > 1)
                yield return $"M{F(segment[0].X)},{F(baseY)} " + string.Join(" ", segment.Select(pt => $"L{F(pt.X)},{F(pt.Y)}")) + $" L{F(segment[^1].X)},{F(baseY)} Z";
            segment.Clear();
        }
    }

    private int? LastIndex(ChartSeries s)
    {
        for (var i = Math.Min(s.Values.Count, Labels.Count) - 1; i >= 0; i--)
            if (s.Values[i] is not null) return i;
        return null;
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (Labels.Count == 0) return;
        if (e.Key == "ArrowRight") _hover = Math.Min(Labels.Count - 1, (_hover ?? -1) + 1);
        else if (e.Key == "ArrowLeft") _hover = Math.Max(0, (_hover ?? Labels.Count) - 1);
        else if (e.Key == "Home") _hover = 0;
        else if (e.Key == "End") _hover = Labels.Count - 1;
        else if (e.Key == "Escape") _hover = null;
    }
}
