@inherits ChartBase

@* Säulendiagramm: gruppiert oder gestapelt, ≤ 24px Säulen, 4px gerundetes Datenende, 2px Lücken, Hover/Tastatur-Tooltip. *@
<div class="chart-wrap" @ref="Container">
    <svg class="chart" width="@Width" height="@Height" viewBox="0 0 @Width @Height" role="img" aria-label="@Title"
         tabindex="0" @onkeydown="OnKey" @onfocusout="() => _hover = null">
        @{
            var plot = Layout();
        }
        @foreach (var t in plot.Ticks)
        {
            var y = plot.Y(t);
            <line class="@(t == 0 ? "axis" : "grid-line")" x1="@F(plot.Left)" x2="@F(Width - 8)" y1="@F(y)" y2="@F(y)" />
            <g><text class="tick-label" x="@F(plot.Left - 6)" y="@F(y + 4)" text-anchor="end">@YAxis(t)</text></g>
        }
        @for (var i = 0; i < Labels.Count; i++)
        {
            var band = plot.Left + plot.Band * i;
            @if (_hover == i)
            {
                <rect x="@F(band)" y="@F(plot.Top)" width="@F(plot.Band)" height="@F(Height - plot.Top - plot.Bottom)" fill="var(--surface-2)" />
            }
            @if (Stacked)
            {
                var w = Math.Min(24, plot.Band * 0.6);
                var x = band + (plot.Band - w) / 2;
                double pos = 0, neg = 0;
                var shown = Series.Select((s, k) => (s, k)).Where(t => i < t.s.Values.Count && t.s.Values[i] is { } v && v != 0).ToList();
                for (var j = 0; j < shown.Count; j++)
                {
                    var (s, _) = shown[j];
                    var v = (double)s.Values[i]!.Value;
                    var from = v >= 0 ? pos : neg;
                    var to = from + v;
                    if (v >= 0) pos = to; else neg = to;
                    var y1 = plot.Y(Math.Max(from, to));
                    var y2 = plot.Y(Math.Min(from, to));
                    var isEnd = j == shown.Count - 1 || shown.Skip(j + 1).All(o => Math.Sign((double)o.s.Values[i]!.Value) != Math.Sign(v));
                    var h = Math.Max(0, y2 - y1 - (isEnd ? 0 : 2));
                    var yTop = v >= 0 ? y1 : y1 + (isEnd ? 0 : 2);
                    <path d="@(isEnd ? BarPath(x, yTop, w, h, v >= 0) : Rect(x, v >= 0 ? y1 : y1 + 2, w, h))" fill="@s.Color" />
                }
            }
            else
            {
                var count = Math.Max(1, Series.Count);
                var w = Math.Min(24, (plot.Band * 0.7 - 2 * (count - 1)) / count);
                var groupW = w * count + 2 * (count - 1);
                var x0 = band + (plot.Band - groupW) / 2;
                for (var k = 0; k < Series.Count; k++)
                {
                    var s = Series[k];
                    if (i >= s.Values.Count || s.Values[i] is not { } v || w <= 0) continue;
                    var y0 = plot.Y(0);
                    var yv = plot.Y((double)v);
                    <path d="@BarPath(x0 + k * (w + 2), Math.Min(y0, yv), w, Math.Abs(y0 - yv), v >= 0)" fill="@s.Color" />
                }
            }
            @if (i % plot.LabelEvery == 0 || i == Labels.Count - 1)
            {
                <g><text x="@F(band + plot.Band / 2)" y="@F(Height - 8)" text-anchor="middle">@Labels[i]</text></g>
            }
        }
        @if (TargetLine is { } target)
        {
            var ty = plot.Y((double)target);
            <line x1="@F(plot.Left)" x2="@F(Width - 8)" y1="@F(ty)" y2="@F(ty)" stroke="var(--text-muted)" stroke-width="1.5" stroke-dasharray="4 4" />
            <g><text x="@F(Width - 10)" y="@F(ty - 5)" text-anchor="end" style="font-size:11px">@TargetLabel</text></g>
        }
        @for (var i = 0; i < Labels.Count; i++)
        {
            var idx = i;
            <rect class="hit" x="@F(plot.Left + plot.Band * i)" y="@F(plot.Top)" width="@F(plot.Band)" height="@F(Height - plot.Top - plot.Bottom)"
                  @onmouseenter="() => _hover = idx" @onmouseleave="() => _hover = null" @onclick="() => Click(idx)"
                  style="@(OnBarClick.HasDelegate ? "cursor:pointer" : null)" />
        }
    </svg>
    @if (_hover is { } hv && hv < Labels.Count)
    {
        var plot2 = Layout();
        var left = Math.Clamp(plot2.Left + plot2.Band * (hv + 1) + 4, 0, Math.Max(0, Width - 200));
        <div class="chart-tooltip" style="left:@F(left)px;top:@F(plot2.Top)px" role="status">
            <strong>@(TooltipLabels?[hv] ?? Labels[hv])</strong>
            @foreach (var s in Series)
            {
                @if (hv < s.Values.Count && s.Values[hv] is { } v)
                {
                    <div class="row" style="gap:.4rem;flex-wrap:nowrap">
                        <span style="width:10px;height:10px;border-radius:3px;background:@s.Color;display:inline-block"></span>
                        <span>@s.Label:</span><strong class="num">@Format(v)</strong>
                    </div>
                }
            }
            @if (Stacked && Series.Count > 1)
            {
                <div class="small muted">@L["chart.total"]: <strong class="num">@Format(Series.Sum(s => hv < s.Values.Count ? s.Values[hv] ?? 0 : 0))</strong></div>
            }
        </div>
    }
    @if (Series.Count > 1 || ShowLegend)
    {
        <div class="chart-legend" aria-hidden="true">
            @foreach (var s in Series)
            {
                <span class="item"><span class="swatch" style="background:@s.Color"></span>@s.Label</span>
            }
        </div>
    }
    <details class="chart-table-toggle">
        <summary class="small">@L["chart.showTable"]</summary>
        <div class="table-wrap mt-1">
            <table class="table">
                <caption class="sr-only">@Title</caption>
                <thead>
                    <tr>
                        <th scope="col">@(XTitle ?? L["chart.period"])</th>
                        @foreach (var s in Series)
                        {
                            <th scope="col" class="num">@s.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Labels.Count; i++)
                    {
                        <tr>
                            <th scope="row">@(TooltipLabels?[i] ?? Labels[i])</th>
                            @foreach (var s in Series)
                            {
                                <td class="num">@(i < s.Values.Count && s.Values[i] is { } v ? Format(v) : "–")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
</div>

@code {
    private int? _hover;

    [Parameter] public IReadOnlyList<string> Labels { get; set; } = [];
    [Parameter] public IReadOnlyList<string>? TooltipLabels { get; set; }
    [Parameter] public IReadOnlyList<ChartSeries> Series { get; set; } = [];
    [Parameter] public bool Stacked { get; set; }
    [Parameter] public Func<decimal, string> Format { get; set; } = v => v.ToString("0.##");
    [Parameter] public Func<decimal, string>? AxisFormat { get; set; }
    [Parameter] public decimal? TargetLine { get; set; }
    [Parameter] public string? TargetLabel { get; set; }
    [Parameter] public string? XTitle { get; set; }
    [Parameter] public bool ShowLegend { get; set; }
    [Parameter] public EventCallback<int> OnBarClick { get; set; }

    private string YAxis(double v) => (AxisFormat ?? Format)((decimal)v);

    private sealed record Plot(double Left, double Top, double Bottom, double Min, double Max, List<double> Ticks, double Band, int LabelEvery, double Height)
    {
        public double Y(double v) => Top + (Max - v) / (Max - Min == 0 ? 1 : Max - Min) * (Height - Top - Bottom);
    }

    private Plot Layout()
    {
        double min = 0, max = 0;
        for (var i = 0; i < Labels.Count; i++)
        {
            if (Stacked)
            {
                double pos = 0, neg = 0;
                foreach (var s in Series)
                    if (i < s.Values.Count && s.Values[i] is { } v) { if (v >= 0) pos += (double)v; else neg += (double)v; }
                max = Math.Max(max, pos);
                min = Math.Min(min, neg);
            }
            else
                foreach (var s in Series)
                    if (i < s.Values.Count && s.Values[i] is { } v) { max = Math.Max(max, (double)v); min = Math.Min(min, (double)v); }
        }
        if (TargetLine is { } t0) max = Math.Max(max, (double)t0);
        var (nMin, nMax, step) = ChartMath.NiceScale(min, max);
        var ticks = new List<double>();
        for (var t = nMin; t <= nMax + step / 2; t += step) ticks.Add(Math.Round(t, 6));
        var labelWidth = ticks.Select(t => YAxis(t).Length).DefaultIfEmpty(4).Max() * 6.6 + 10;
        var left = Math.Min(labelWidth, Width * 0.35);
        var plotW = Math.Max(10, Width - left - 8);
        var band = plotW / Math.Max(1, Labels.Count);
        var labelChars = Labels.Count == 0 ? 4 : Labels.Max(l => l.Length);
        var every = Math.Max(1, (int)Math.Ceiling(labelChars * 7.5 / band));
        return new Plot(left, 12, 28, nMin, nMax, ticks, band, every, Height);
    }

    private static string Rect(double x, double y, double w, double h) =>
        h <= 0 ? "" : $"M{F(x)},{F(y)} h{F(w)} v{F(h)} h{F(-w)} Z";

    private async Task Click(int i)
    {
        _hover = i;
        if (OnBarClick.HasDelegate) await OnBarClick.InvokeAsync(i);
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (Labels.Count == 0) return;
        if (e.Key == "ArrowRight") _hover = Math.Min(Labels.Count - 1, (_hover ?? -1) + 1);
        else if (e.Key == "ArrowLeft") _hover = Math.Max(0, (_hover ?? Labels.Count) - 1);
        else if (e.Key is "Enter" or " " && _hover is { } h && OnBarClick.HasDelegate) _ = OnBarClick.InvokeAsync(h);
        else if (e.Key == "Escape") _hover = null;
    }
}
