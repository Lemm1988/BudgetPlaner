@page "/budget"
@inherits AppComponent
@using BudgetPlaner.Client.Components.Budget

<PageTitle>@L["nav.budget"] · @L.Period(Selected) · @L["app.name"]</PageTitle>

<KpiBar />

<div class="page">
    <div class="page-head">
        <div>
            <h1>@L["nav.budget"]</h1>
            <p class="lead">@L["budget.lead"]</p>
        </div>
        <div class="page-actions">
            @if (!IsClosed)
            {
                <button class="btn btn-primary desktop-only" @onclick="() => NewEntry(null)"><Icon Name="plus" />@L["budget.newEntry"]</button>
                <button class="btn @(_sortMode ? "btn-soft" : "")" aria-pressed="@(_sortMode ? "true" : "false")" @onclick="() => _sortMode = !_sortMode">
                    <Icon Name="sort" />@(_sortMode ? L["budget.sortDone"] : L["budget.sort"])
                </button>
            }
            <div class="menu-wrap">
                <OutsideClick OnOutside="() => _menu = false" Active="_menu">
                    <button class="btn" aria-haspopup="menu" aria-expanded="@(_menu ? "true" : "false")" @onclick="() => _menu = !_menu"><Icon Name="more" />@L["action.more"]</button>
                    @if (_menu)
                    {
                        <div class="menu" role="menu">
                            <button role="menuitem" @onclick="() => { _menu = false; _categories = true; }"><Icon Name="layers" />@L["categories.title"]</button>
                            <button role="menuitem" @onclick="() => { _menu = false; _showEmpty = !_showEmpty; }"><Icon Name="eye" />@(_showEmpty ? L["budget.hideEmpty"] : L["budget.showEmpty"])</button>
                            <button role="menuitem" @onclick="() => { _menu = false; _showNotDue = !_showNotDue; }"><Icon Name="calendar" />@(_showNotDue ? L["budget.hideNotDue"] : L["budget.showNotDue"])</button>
                            <div class="sep"></div>
                            @if (IsClosed)
                            {
                                <button role="menuitem" @onclick="ReopenAsync"><Icon Name="undo" />@L["close.reopen"]</button>
                            }
                            else if (CanClose)
                            {
                                <button role="menuitem" @onclick="() => { _menu = false; _close = true; }"><Icon Name="check-circle" />@L["close.button"]</button>
                            }
                        </div>
                    }
                </OutsideClick>
            </div>
        </div>
    </div>

    @if (IsClosed && Month.Snapshot is { } snap)
    {
        <div class="notice info mb-2">
            <Icon Name="lock" />
            <div style="flex:1">
                <strong>@L.T("close.closedOn", L.DateTime(snap.ClosedAt))</strong>
                <p class="small mb-0">@L["close.closedHint"]</p>
            </div>
            <button class="btn btn-sm" @onclick="ReopenAsync">@L["close.reopen"]</button>
        </div>
    }

    <section class="card mb-2" aria-labelledby="central">
        <div class="grid grid-2" style="align-items:center">
            <div>
                <h2 id="central" class="row" style="gap:.25rem">@L["overview.central"] <InfoTip Term="unverplant" /></h2>
                <dl class="detail-grid">
                    @if (Month.CarryIn != 0)
                    {
                        <div><dt>@L["budget.carryIn"] <InfoTip Term="uebertrag" /></dt><dd class="num">@L.Money(Month.CarryIn, true)</dd></div>
                    }
                    <div><dt>@L["kpi.income"]</dt><dd class="num pos">@L.Money(Month.Income)</dd></div>
                    <div><dt>@L["kpi.expenses"]</dt><dd class="num">@L.Money(Month.Expenses)</dd></div>
                    <div><dt>@L["kpi.allocations"]</dt><dd class="num">@L.Money(Month.Allocations)</dd></div>
                    @if (Month.Withdrawals != 0)
                    {
                        <div><dt>@L["budget.withdrawals"]</dt><dd class="num pos">@L.Money(Month.Withdrawals, true)</dd></div>
                    }
                    <div><dt>@L["kpi.unassigned"]</dt><dd class="num @(Month.Unverplant < 0 ? "neg" : "")">@L.Money(Month.Unverplant)</dd></div>
                </dl>
            </div>
            <div>
                <Zielzone Unverplant="Month.Unverplant" Income="Month.Income" />
                @if (!IsClosed && CanClose && Selected < Current)
                {
                    <button class="btn btn-sm mt-1" @onclick="() => _close = true"><Icon Name="check-circle" />@L["close.button"]</button>
                }
            </div>
        </div>
    </section>

    @if (_sortMode)
    {
        <div class="notice info mb-2"><Icon Name="info" /><p class="mb-0">@L["budget.sortHint"]</p></div>
    }

    @if (Ix.Entries.Count == 0)
    {
        <div class="card">
            <EmptyState Icon="wallet" Title="@L["budget.emptyTitle"]" Text="@L["budget.emptyText"]">
                <div class="row" style="justify-content:center">
                    <button class="btn btn-primary" @onclick="() => NewEntry(IncomeDefault)"><Icon Name="plus" />@L["budget.addIncome"]</button>
                    <button class="btn" @onclick="() => NewEntry(null)"><Icon Name="plus" />@L["budget.addExpense"]</button>
                </div>
            </EmptyState>
        </div>
    }

    @foreach (var root in Roots)
    {
        var blocks = BlocksFor(root);
        var groupLines = Month.Lines.Where(l => (l.RootCategoryId ?? l.CategoryId) == root.Id).ToList();
        if (blocks.Count == 0 && !_showEmpty) continue;
        var sum = groupLines.Sum(l => l.Effective);
        <section class="group" aria-labelledby="g-@root.Id">
            <div class="group-head">
                <CategoryIcon Color="@root.Color" IconName="@root.Icon" />
                <h2 id="g-@root.Id">@L.Cat(root)</h2>
                @if (Target(root) is { } target && Month.Income > 0)
                {
                    <span class="group-target">@L.T("budget.groupShare", L.Pct(sum / Month.Income * 100, 0), L.Pct(target, 0))</span>
                    <InfoTip Term="regel503020" />
                }
                <span class="sum @(root.Type == CategoryType.Income ? "pos" : "")">@L.Money(sum)</span>
            </div>
            @foreach (var block in blocks)
            {
                var lines = block.Lines;
                var blockSum = lines.Sum(l => l.Effective);
                var ampel = Engine.Ampel.ForCategory(Selected, block.Category.Id);
                <div class="cat-block">
                    <div class="cat-head">
                        <h3><span class="chip" style="padding:.15rem"><span class="dot" style="background:@block.Category.Color"></span></span>@(block.IsRootBlock ? L["budget.generalIn"] + " " + L.Cat(block.Category) : L.Cat(block.Category))</h3>
                        @if (ampel is not null && Month.Income > 0)
                        {
                            <AmpelBadge Item="ampel" Compact="true" Label="@L.Cat(block.Category)" />
                        }
                        <span class="sum">@L.Money(blockSum)</span>
                    </div>
                    <SortableList Enabled="_sortMode" OnReorder="t => ReorderAsync(lines, t.From, t.To)">
                        @if (lines.Count > 150 && !_sortMode)
                        {
                            <Virtualize Items="lines" ItemSize="53" Context="line">
                                <EntryRow Line="line" Entry="Ix.EntryById.GetValueOrDefault(line.EntryId)" Period="Selected" ReadOnly="IsClosed" OnEdit="Edit" />
                            </Virtualize>
                        }
                        else
                        {
                            @foreach (var line in lines)
                            {
                                <EntryRow @key="line.EntryId" Line="line" Entry="Ix.EntryById.GetValueOrDefault(line.EntryId)" Period="Selected" ReadOnly="IsClosed"
                                          SortMode="_sortMode" OnEdit="Edit" OnMove="d => MoveAsync(lines, line, d)" />
                            }
                        }
                    </SortableList>
                    @if (_showNotDue)
                    {
                        @foreach (var e in NotDue(block.Category.Id, block.IsRootBlock))
                        {
                            <div class="entry paused">
                                <div class="entry-row">
                                    <span style="width:44px"></span>
                                    <button class="entry-main" @onclick="() => Edit(e)">
                                        <span class="entry-name">@e.Name</span>
                                        <span class="entry-meta">@L.Of(e.Rhythm) · @NextDueText(e)</span>
                                    </button>
                                    <span class="entry-amount"><span class="nominal">@L.Money(EntrySchedule.ScheduledAmount(Ix, e, Selected).Amount)</span></span>
                                </div>
                            </div>
                        }
                    }
                    @if (!IsClosed && !_sortMode)
                    {
                        <button class="add-row" @onclick="() => NewEntry(block.Category)"><Icon Name="plus" />@L.T("budget.addTo", L.Cat(block.Category))</button>
                    }
                </div>
            }
            @if (!IsClosed && HiddenCategories(root).Count > 0 && !_sortMode)
            {
                <div class="row mt-1">
                    <label class="sr-only" for="add-area-@root.Id">@L["budget.addArea"]</label>
                    <select id="add-area-@root.Id" class="select" style="max-width:20rem" @onchange="e => AddArea(e.Value?.ToString())">
                        <option value="">+ @L["budget.addArea"]</option>
                        @foreach (var c in HiddenCategories(root))
                        {
                            <option value="@c.Id">@L.Cat(c)</option>
                        }
                    </select>
                </div>
            }
        </section>
    }
</div>

@if (!IsClosed)
{
    <button class="fab" aria-label="@L["budget.newEntry"]" @onclick="() => NewEntry(null)"><Icon Name="plus" /></button>
}

@if (_editing is not null)
{
    <EntryDialog Entry="_editing" Period="Selected" OnClose="() => _editing = null" />
}
@if (_close)
{
    <CloseMonthDialog Period="Selected" OnClose="() => _close = false" />
}
@if (_categories)
{
    <CategoryManager OnClose="() => _categories = false" />
}

@code {
    private bool _sortMode;
    private bool _showEmpty;
    private bool _showNotDue;
    private bool _menu;
    private bool _close;
    private bool _categories;
    private BudgetEntry? _editing;
    private string? _lastQuery;

    [SupplyParameterFromQuery(Name = "monat")] public string? Monat { get; set; }

    private sealed record Block(Category Category, bool IsRootBlock, List<EntryLine> Lines);

    private MonthResult Month => Engine.Month(Selected);
    private bool IsClosed => Month.IsClosed;
    private bool CanClose => Ix.Calendar.Start(Selected) <= DataStore.Today && Month.Lines.Count > 0;
    private Category? IncomeDefault => Ix.Categories.FirstOrDefault(c => c.DefaultKey == "salary");

    private IEnumerable<Category> Roots => Ix.Categories.Where(c => c.ParentId is null)
        .OrderBy(c => c.Type == CategoryType.Income ? 0 : c.DefaultKey == "other" ? 2 : 1).ThenBy(c => c.SortIndex);

    protected override void OnParametersSet()
    {
        if (Monat != _lastQuery)
        {
            _lastQuery = Monat;
            if (Period.TryParse(Monat, out var p)) Ui.SetPeriod(p);
        }
    }

    private List<Block> BlocksFor(Category root)
    {
        var blocks = new List<Block>();
        var direct = Month.Lines.Where(l => l.CategoryId == root.Id).ToList();
        if (direct.Count > 0 || (_showNotDue && NotDue(root.Id, true).Any())) blocks.Add(new Block(root, true, direct));
        foreach (var child in Ix.Categories.Where(c => c.ParentId == root.Id).OrderBy(c => c.SortIndex))
        {
            var lines = Month.Lines.Where(l => l.CategoryId == child.Id).ToList();
            var visible = lines.Count > 0 || _showEmpty || (_showNotDue && NotDue(child.Id, false).Any());
            if (visible) blocks.Add(new Block(child, false, lines));
        }
        return blocks;
    }

    /// <summary>Ausgeblendete leere Bereiche (B-05) zum Wiedereinblenden.</summary>
    private List<Category> HiddenCategories(Category root) =>
        _showEmpty ? [] : Ix.Categories.Where(c => c.ParentId == root.Id && Month.Lines.All(l => l.CategoryId != c.Id)).ToList();

    private IEnumerable<BudgetEntry> NotDue(Guid categoryId, bool rootBlock) =>
        Ix.Entries.Where(e => e.CategoryId == categoryId && EntrySchedule.IsActive(e, Selected) && !EntrySchedule.IsDue(e, Selected))
            .Concat(Ix.Entries.Where(e => e.CategoryId == categoryId && e.StartPeriod > Selected));

    private string NextDueText(BudgetEntry e) => EntrySchedule.NextDue(e, Selected) is { } p ? L.T("budget.nextDue", L.Period(p)) : L["budget.noNextDue"];

    private decimal? Target(Category root) => root.Group switch
    {
        BudgetGroup.Needs => Engine.Rules.TargetNeedsPercent,
        BudgetGroup.Wants => Engine.Rules.TargetWantsPercent,
        BudgetGroup.Savings => Engine.Rules.TargetSavingsPercent,
        _ => null,
    };

    private void NewEntry(Category? category)
    {
        var cat = category ?? Ix.Categories.FirstOrDefault(c => c.DefaultKey == "living") ?? Ix.Categories.First(c => c.Type == CategoryType.Expense);
        var kind = cat.Type == CategoryType.Income ? EntryKind.Income : EntryKind.Expense;
        _editing = Act.NewEntry(kind, cat.Id, Selected);
    }

    private void AddArea(string? id)
    {
        if (Guid.TryParse(id, out var g) && Ix.CategoryById.TryGetValue(g, out var c)) NewEntry(c);
    }

    private void Edit(BudgetEntry e) => _editing = e;

    private async Task ReorderAsync(List<EntryLine> lines, int from, int to)
    {
        var entries = lines.Select(l => Ix.EntryById.GetValueOrDefault(l.EntryId)).Where(e => e is not null).Select(e => e!).ToList();
        if (from < 0 || from >= entries.Count) return;
        var item = entries[from];
        entries.RemoveAt(from);
        entries.Insert(Math.Clamp(to, 0, entries.Count), item);
        await Act.ReorderAsync(entries);
    }

    private async Task MoveAsync(List<EntryLine> lines, EntryLine line, int delta)
    {
        var entries = lines.Select(l => Ix.EntryById.GetValueOrDefault(l.EntryId)).Where(e => e is not null).Select(e => e!).ToList();
        var entry = entries.FirstOrDefault(e => e.Id == line.EntryId);
        if (entry is not null) await Act.MoveAsync(entry, entries, delta);
    }

    private async Task ReopenAsync()
    {
        _menu = false;
        if (await Confirm.AskAsync(L["close.reopenTitle"], L.T("close.reopenText", L.Period(Selected)), L["close.reopen"]))
            await Act.ReopenMonthAsync(Selected);
    }
}
